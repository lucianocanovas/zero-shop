# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env)
# Copia este archivo a '.env' y completa los valores correspondientes
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos PostgreSQL (Docker / Producción)
# ------------------------------------------------------------------------------
DB_NAME=zero-shop
DB_USER=postgres
DB_PASSWORD=SuperPasswordProduccion2026!

# ------------------------------------------------------------------------------
# 2. Configuración de Red / Puerto del Servidor
# ------------------------------------------------------------------------------
# Puerto externo donde escuchará la aplicación (por defecto 80 para HTTP directo)
HTTP_PORT=80
# URL base para callbacks o enlaces públicos (ej. http://181.xxx.xxx.xxx o tu dominio)
APP_BASE_URL=http://localhost

# ------------------------------------------------------------------------------
# 3. Credenciales de Correo (Spring Mail / Gmail SMTP - Opcional)
# ------------------------------------------------------------------------------
# Para Gmail: Cuenta de Google -> Seguridad -> Verificación en 2 pasos -> Contraseñas de aplicaciones
MAIL_USERNAME=
MAIL_PASSWORD=

# ------------------------------------------------------------------------------
# 4. Mercado Pago SDK (Opcional para pruebas de pago)
# ------------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
